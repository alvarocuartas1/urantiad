# Copy to backend/.env for running the backend outside Docker.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://urantiad:urantiad@localhost:5432/urantiad
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Used by pytest; defaults to this value when unset.
TEST_DATABASE_URL=postgresql+psycopg://urantiad:urantiad@localhost:5432/urantiad_test
