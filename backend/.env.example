# Copy to backend/.env for running the backend outside Docker.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://urantiad:urantiad@localhost:5432/urantiad
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Used by pytest; defaults to this value when unset.
TEST_DATABASE_URL=postgresql+psycopg://urantiad:urantiad@localhost:5432/urantiad_test

# Authentication. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12
# Set to true in production (HTTPS only).
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
