# Production settings for docker-compose.prod.yml. Copy to .env.production on the server
# (never commit it) and fill in every value marked "change".
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Public domain pointing to this server (DNS A/AAAA record). Caddy obtains its HTTPS
# certificate from Let's Encrypt. "localhost" uses a local certificate (for testing).
DOMAIN=pos.example.com

# PostgreSQL (not published outside the server).
POSTGRES_USER=urantiad
POSTGRES_DB=urantiad
# change: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# change: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

LOG_LEVEL=INFO
ALLOW_NEGATIVE_STOCK=false
BUSINESS_TIMEZONE=America/Bogota
# Backend processes (2 suits a small VPS).
WEB_CONCURRENCY=2

# Docker network of Caddy and the backend; change only if it clashes with a local network.
WEB_SUBNET=172.30.10.0/24

# Days a backup is kept by scripts/backup.sh.
BACKUP_KEEP_DAYS=14
