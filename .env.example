# Copy to .env (project root). Used by docker compose.
POSTGRES_USER=urantiad
POSTGRES_PASSWORD=urantiad
POSTGRES_DB=urantiad
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Authentication. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Inventory: allow outgoing movements to leave negative stock.
ALLOW_NEGATIVE_STOCK=false
