{
  "info": {
    "name": "URANTIAD API",
    "description": "Colección de la API REST de URANTIAD. Ajuste la variable baseUrl según el entorno.\n\nAutenticación: ejecute 'Auth > Login' (guarda el access token en la variable accessToken; Postman conserva la cookie del refresh token). Cuando el token expire (15 min) ejecute 'Auth > Refresh'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "",
      "description": "Complete localmente; no la guarde en el repositorio."
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "supplierId",
      "value": "1"
    },
    {
      "key": "purchaseId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Público. 200 si la API y la base de datos responden; 503 si la base de datos no está disponible.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Database ok', () => pm.expect(pm.response.json().database).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Público. Devuelve el access token (Bearer) y deja el refresh token en una cookie httpOnly. Tras 5 intentos fallidos la cuenta se bloquea 15 minutos.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Usa la cookie refresh_token. Rota el refresh token y devuelve un access token nuevo.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Autenticado. Usuario con su rol y permisos."
          }
        },
        {
          "name": "Cambiar mi contraseña",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/auth/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me",
                "password"
              ]
            },
            "description": "Autenticado. Cierra las sesiones en otros equipos. 204.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"new_password\": \"NuevaClave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revoca la sesión actual y borra la cookie. 204.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
