{
  "info": {
    "name": "URANTIAD API",
    "description": "Colección de la API REST de URANTIAD. Ajuste la variable baseUrl según el entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8000/api/v1" }],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Público. Devuelve 200 si la API y la base de datos responden; 503 si la base de datos no está disponible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Database ok', () => pm.expect(pm.response.json().database).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
